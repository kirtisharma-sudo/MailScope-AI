# Copy to .env and fill in real values. Never commit the real .env file.

# --- Mode ---
DEMO_MODE=false

# --- Supabase (server-side only — never expose these to the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- External threat-intel APIs (optional; features report "unavailable" if unset) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=

# --- NLP model ---
NLP_MODEL_PATH=../models/deberta-phishing
NLP_MODEL_VERSION=not_loaded

# --- Risk engine weights (must sum to ~1.0) ---
RISK_WEIGHT_NLP=0.35
RISK_WEIGHT_AUTH=0.20
RISK_WEIGHT_URL=0.20
RISK_WEIGHT_HEADER=0.15
RISK_WEIGHT_NETWORK=0.10

ANALYSIS_VERSION=mailscope-backend-0.1.0
MAX_UPLOAD_BYTES=5242880

# --- CORS: add the origin(s) the frontend is served from ---
# Local split dev (frontend on a static server, backend on :8000):
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Production (Render): the frontend is served BY this same backend at "/",
# so same-origin requests don't need CORS at all. Only add extra origins
# here if you separately host the frontend elsewhere, e.g.:
# ALLOWED_ORIGINS=https://your-service-name.onrender.com

# --- Port ---
# Render provides $PORT automatically at runtime — do not set this manually
# in Render's dashboard. Only relevant for some non-Render hosts.
# PORT=8000
